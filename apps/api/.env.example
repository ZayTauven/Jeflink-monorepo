# Optionnel en local : le câblage de dev (base, redis, stockage S3, SECRET_KEY de dev) est déjà
# déclaré dans infra/docker-compose.yml. Ce fichier ne porte que les secrets et les options.
# cp apps/api/.env.example apps/api/.env

# IA (côté serveur uniquement)
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5-20251001

# Paiements : cash | manual_mobile_money | wiipay | fake
PAYMENT_GATEWAY=manual_mobile_money

# Secrets applicatifs — OBLIGATOIRES hors local (en local, docker-compose fournit des valeurs de dev).
# Chacun : ≥ 32 octets, distinct des autres et de SECRET_KEY, sinon l'API refuse de démarrer.
# DJANGO_ENV=production
# SECRET_KEY=
# JWT_SIGNING_KEYS=kid1:…,kid2:…
# OTP_HMAC_KEY=
# MFA_ENCRYPTION_KEYS=            (clés Fernet, séparées par des virgules)
# BFF_SHARED_SECRETS=             (2 valeurs pendant une rotation)
# PII_HMAC_KEY=
