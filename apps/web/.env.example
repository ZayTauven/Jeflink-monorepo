# apps/web — variables SERVEUR du BFF (spec 001, « BFF Next »). Lues à l'exécution, jamais au build :
# `next build` passe sans aucune d'elles. Jamais de préfixe NEXT_PUBLIC_ ici.
# En local, copier dans apps/web/.env.local et compléter.

# API Django. Production : hôte interne (https://api, autorité interne via NODE_EXTRA_CA_CERTS).
JEFLINK_API_URL=
# Secret partagé avec Django : une des valeurs de BFF_SHARED_SECRETS (32 caractères au moins).
# En local, la valeur de dev publique se trouve dans infra/docker-compose.yml.
BFF_SHARED_SECRET=
# Origines exactes acceptées pour toute requête non GET, séparées par des virgules.
# Production : https://<domaine public>. Local : http://localhost:3000.
BFF_ALLOWED_ORIGINS=
# En-tête qui porte l'IP cliente, posé (et écrasé) par le proxy de bord devant Next, ex. x-real-ip.
# Obligatoire en production ; jamais X-Forwarded-For. Vide en local : 127.0.0.1.
BFF_CLIENT_IP_HEADER=
# Domaine parent (ex. jeflink.sn), obligatoire en production : un refresh planté par un
# sous-domaine avec ce Domain est alors effacé lui aussi. Vide en local.
BFF_COOKIE_DOMAIN=

# Numéro WhatsApp du support (E.164, ex. +221 33 000 00 00), affiché sur chaque erreur de connexion.
# Public, mais lu à l'exécution. Obligatoire en production ; vide en local (liens masqués).
SUPPORT_WHATSAPP_NUMBER=
