# Tout fichier d'environnement, à tous les niveaux (.env.local, .env.production…), sauf les exemples
.env*
!.env.example
node_modules/
.next/
dist/
.turbo/
__pycache__/
.venv/
.claude/settings.local.json

# Matériel de référence local (templates sous licence Envato, originaux lourds) — jamais versionné
references/

# Python / outils
.pytest_cache/
.ruff_cache/
apps/api/staticfiles/
apps/api/db.sqlite3
apps/api/media/

# Copie locale du template Crafto (licence Envato) : générée par `pnpm --filter web crafto`
apps/web/public/crafto/

