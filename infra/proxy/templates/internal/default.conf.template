# Écouteur interne de l'API (spec 001, infra 4) : réseau privé seulement, jamais exposé à
# Internet. Sert le BFF Next (web, console) et l'admin Django de l'équipe technique (par VPN ou
# bastion), en TLS avec un certificat d'une autorité interne : les réglages de production
# (SECURE_SSL_REDIRECT, cookies Secure de l'admin) s'appliquent sans exception.
# Variables : API_UPSTREAM (ex. api:8000), TLS_CERT, TLS_KEY (certificat pour le nom « api »).

server_tokens off;

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    ssl_reject_handshake on;
    return 444;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api;

    ssl_certificate     ${TLS_CERT};
    ssl_certificate_key ${TLS_KEY};
    ssl_protocols TLSv1.3;

    location ^~ /api/schema { return 404; }
    location ^~ /api/docs   { return 404; }

    location / {
        # Ici les en-têtes X-Jeflink-* du BFF passent : Django ne les croit que si la connexion
        # vient de BFF_TRUSTED_NETWORKS, par l'hôte interne, avec le secret partagé (S9).
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Host api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        client_max_body_size 12m;
        proxy_pass http://${API_UPSTREAM};
    }
}
